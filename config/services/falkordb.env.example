# The official client accepts Redis protocol URLs. Use rediss:// for hosted TLS.
MUSCLE_MEMORY_FALKORDB_URL=rediss://username:password@host.example:6379
MUSCLE_MEMORY_FALKORDB_GRAPH=muscle_memory
MUSCLE_MEMORY_FALKORDB_QUERY_TIMEOUT_MS=2000
MUSCLE_MEMORY_FALKORDB_CACHE_PATH=.cache/muscle-memory/falkordb-events.jsonl
