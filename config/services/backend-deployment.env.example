# Generate the real ignored file with: python3 -m ops.deployment.environment
COMPOSE_PROJECT_NAME=muscle-memory
MM_API_BIND_ADDRESS=127.0.0.1
MM_PROVIDER_BIND_ADDRESS=127.0.0.1
MM_API_PORT=8000
MM_API_BACKEND_FACTORY=muscle_memory.runtime:create_api_backend
MM_API_LOG_LEVEL=info
MM_LIVE_MAX_DURATION_SECONDS=30
MM_LIVE_RENDER_WIDTH=320
MM_LIVE_RENDER_HEIGHT=240
MM_LIVE_JPEG_QUALITY=82
MM_API_OPERATOR_TOKEN=<generated-local-operator-token>
MM_API_OPERATOR_TOKEN_SHA256=<sha256-of-generated-local-operator-token>
MM_DAYTONA_STATE_DIR=/home/daytona/mm-data
MM_DAYTONA_SNAPSHOT_DIR=/data/muscle-memory-snapshots

# Optional immutable held-out admission. Leave all four blank, or set all four;
# partial configuration fails closed in the runtime and Daytona launcher.
MM_HELDOUT_EVALUATION_ARTIFACT=
MM_HELDOUT_EVALUATION_ARTIFACT_SHA256=
MM_HELDOUT_CANDIDATE_CHECKPOINT=
MM_HELDOUT_EVALUATED_AT=
MM_STABLE_POLICY_ALIAS=stable

# Local self-hosted development providers. Use distinct random values.
IGGY_ROOT_USERNAME=iggy
IGGY_ROOT_PASSWORD=<generated-url-safe-password>
IGGY_TCP_PORT=8090
FALKORDB_PASSWORD=<generated-url-safe-password>
FALKORDB_PORT=6379

# Optional managed provider overrides. When set, the API uses these instead of the
# local service addresses. Their presence is configuration, not verification proof.
LASERDATA_CONNECTION_STRING=
MUSCLE_MEMORY_FALKORDB_URL=
MUSCLE_MEMORY_GUILD_OWNER=
MUSCLE_MEMORY_GUILD_WORKSPACE=
MUSCLE_MEMORY_GUILD_BASE_URL=https://app.guild.ai
MUSCLE_MEMORY_GUILD_WORLD_AND_PHYSICS_CREDENTIALS=
MUSCLE_MEMORY_GUILD_FAILURE_AND_CURRICULUM_CREDENTIALS=
MUSCLE_MEMORY_GUILD_SAFETY_AND_EVALUATION_CREDENTIALS=
ROCKETRIDE_URI=
ROCKETRIDE_APIKEY=
ROCKETRIDE_MM_COORDINATOR_URL=
ROCKETRIDE_MM_COORDINATOR_TOKEN=
ROCKETRIDE_VERIFY_ENVELOPE_FILE=
ROCKETRIDE_REQUEST_TIMEOUT_MS=120000
MM_ASSET_REFERENCE_ENDPOINT=
MM_ASSET_REFERENCE_API_KEY=
MM_ASSET_TRELLIS_ENDPOINT=
MM_ASSET_TRELLIS_API_KEY=
