{
  "pipeline": {
    "components": [
    {
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "id": "fixed_step_source",
      "provider": "webhook",
      "ui": {
        "formDataValid": true,
        "measured": {
          "height": 66,
          "width": 150
        },
        "nodeType": "default",
        "position": {
          "x": 20,
          "y": 200
        }
      }
    },
    {
      "config": {
        "apiKey": "",
        "asyncTimeout": 120,
        "baseUrl": "${ROCKETRIDE_MM_COORDINATOR_URL}",
        "mode": "sync",
        "parameters": {},
        "payloadMode": "simple",
        "readOnly": true,
        "syncTimeout": 120,
        "type": "tool_n8n",
        "verifyTls": true,
        "webhookAuth": "bearer",
        "webhookToken": "${ROCKETRIDE_MM_COORDINATOR_TOKEN}",
        "workflow": "muscle-memory-fixed-step"
      },
      "id": "coordinator_callback",
      "input": [
        {
          "from": "fixed_step_source",
          "lane": "text"
        }
      ],
      "provider": "tool_n8n",
      "ui": {
        "formDataValid": true,
        "measured": {
          "height": 66,
          "width": 150
        },
        "nodeType": "default",
        "position": {
          "x": 240,
          "y": 200
        }
      }
    },
    {
      "config": {
        "laneName": "text"
      },
      "id": "typed_result",
      "input": [
        {
          "from": "coordinator_callback",
          "lane": "text"
        }
      ],
      "provider": "response_text",
      "ui": {
        "formDataValid": true,
        "measured": {
          "height": 66,
          "width": 150
        },
        "nodeType": "default",
        "position": {
          "x": 460,
          "y": 200
        }
      }
    }
    ],
    "project_id": "00000000-0000-0000-0000-000000000000",
    "source": "fixed_step_source",
    "viewport": {
      "x": 0,
      "y": 0,
      "zoom": 1
    },
    "version": 1
  }
}
